function swipeUntilTapXulite(timeoutSec)
 local start = os.time()
 local lastSwipeAt = 0
 local lastTapAt = 0
 local everSeenXulite = false
 while os.time() - start < timeoutSec do
  ensureTikTokLiteForeground()

  if hasXuliteTappedScreen() then
   status("Tap Xulite thành công: đã vào màn hình sau xu")
   return true, "tapped_screen"
  end

  local xuliteVisible = bgFindImage(XULITE_IMG, 82, 0, 0, 750, 1334)
  if xuliteVisible then everSeenXulite = true end
  if xuliteVisible and os.time() - lastTapAt >= 2 then
   status("Ưu tiên tap Xulite mỗi 2s nếu thấy ảnh")
   tapXuliteOnceIfVisible()
   lastTapAt = os.time()
   if waitXuliteTappedScreenQuick(1500) then
    return true, "tapped_screen"
   end
  end

  if hasXuliteTappedScreen() then
   status("Tap Xulite thành công: đã vào màn hình sau xu")
   return true, "tapped_screen"
  end

  if os.time() - lastSwipeAt >= 2 then
   status("Ưu tiên swipe up mỗi 2s tới khi tap được Xulite")
   swipeUpOnce()
   lastSwipeAt = os.time()
   if waitXuliteTappedScreenQuick(500) then
    return true, "tapped_screen"
   end
  end

  if hasAnyOnboardingPopup() then
   handleAnyPopupOnceForXulite()
   if waitXuliteTappedScreenQuick(300) then
    return true, "tapped_screen"
   end
  end
  waitPhase(300)
 end
 if everSeenXulite then
  status("Timeout sau khi đã từng thấy Xulite, không restart Stage 1")
  return true, "seen"
 end
 status("Timeout " .. tostring(timeoutSec) .. "s: Xulite lần đầu không xuất hiện")
 return false, "not_seen"
end

function waitFinalColorStable(stableSec, timeoutSec)
 local stableStart = nil
 local start = os.time()
 while os.time() - start < timeoutSec do
  ensureTikTokLiteForeground()
  local x, y = screen.find_color({
   {662,601,0xe31a10},
   {122,594,0xe41a10},
   {639,360,0xffec86},
   {591,156,0xffec86},
   {153,174,0xffec86},
   {113,363,0xffec86},
  },95,0,0,0,0)
  if x ~= -1 then
   if not stableStart then stableStart = os.time() end
   status("Hit final color at " .. tostring(x) .. "," .. tostring(y) .. " stable " .. tostring(os.time() - stableStart) .. "/" .. tostring(stableSec) .. "s")
   if os.time() - stableStart >= stableSec then return true end
  else
   stableStart = nil
  end
  waitPhase(500)
 end
 return false
end

